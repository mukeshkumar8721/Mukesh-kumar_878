#include <stdio.h>
#include <conio.h>

void main()
{
    FILE *fp;
    char name[300];

    // 1. Writing data into file
    fp = fopen("feedback.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "c programming class feedback:-\n class is very interesting and learning lots of new things ");

    fclose(fp);

    printf("Data written successfully\n");

    fp = fopen("feedback.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "\n In previous classes we cant able to understand the programs but now it's okay than previous session ");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("feedback.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }
}
